#!/usr/bin/env python3
"""
BGOOM Headless Companion (macOS / Linux)
Zero UI, zero background RAM. Queues files or selected text into ~/BgoomDrop/outbox/
so BGOOM Android pulls them in 1-2s over the existing encrypted SSH session.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import uuid
import zipfile


def notify_desktop(title: str, body: str) -> None:
    safe_t = title.replace('"', "'").replace("\n", " ")[:60]
    safe_b = body.replace('"', "'").replace("\n", " ")[:140]
    if sys.platform == "darwin":
        script = f'display notification "{safe_b}" with title "{safe_t}" sound name "Glass"'
        subprocess.run(["osascript", "-e", script], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif shutil.which("notify-send"):
        subprocess.run(["notify-send", safe_t, safe_b], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ensure_dirs(base_dir: str):
    files_dir = os.path.join(base_dir, "outbox", "files")
    events_dir = os.path.join(base_dir, "outbox", "events")
    notes_dir = os.path.join(base_dir, "notes")
    os.makedirs(files_dir, exist_ok=True)
    os.makedirs(events_dir, exist_ok=True)
    os.makedirs(notes_dir, exist_ok=True)
    return files_dir, events_dir, notes_dir


def atomic_write_json(path: str, payload: dict) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False)
    os.replace(tmp, path)


def queue_files(paths: list[str], base_dir: str) -> None:
    files_dir, events_dir, _ = ensure_dirs(base_dir)
    sent_names = []
    for raw_path in paths:
        src = os.path.abspath(os.path.expanduser(raw_path))
        if not os.path.exists(src):
            continue
        uid = uuid.uuid4().hex[:8]
        ts = int(time.time() * 1000)
        base_name = os.path.basename(src.rstrip(os.sep)) or f"item_{uid}"

        if os.path.isdir(src):
            zip_name = f"{base_name}.zip"
            dst_path = os.path.join(files_dir, f"{ts}_{uid}_{zip_name}")
            with zipfile.ZipFile(dst_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
                for root, _, fnames in os.walk(src):
                    for fn in fnames:
                        if fn.startswith("._") or fn == ".DS_Store":
                            continue
                        full = os.path.join(root, fn)
                        rel = os.path.relpath(full, os.path.dirname(src))
                        zf.write(full, rel)
            display_name = zip_name
        else:
            dst_path = os.path.join(files_dir, f"{ts}_{uid}_{base_name}")
            shutil.copy2(src, dst_path)
            display_name = base_name

        stored_name = os.path.basename(dst_path)
        event = {
            "type": "file",
            "id": uid,
            "fileName": display_name,
            "storedName": stored_name,
            "remotePath": dst_path,
            "createdAt": ts,
        }
        atomic_write_json(os.path.join(events_dir, f"{ts}_{uid}.json"), event)
        sent_names.append(display_name)

    if sent_names:
        summary = sent_names[0] if len(sent_names) == 1 else f"{sent_names[0]} 等 {len(sent_names)} 个文件"
        notify_desktop("大爆 BGOOM · 已发往手机", f"{summary}（手机端开启实时接收将自动落盘）")


def queue_text(text: str, title: str, base_dir: str) -> None:
    cleaned = text.strip()
    if not cleaned:
        return
    _, events_dir, notes_dir = ensure_dirs(base_dir)
    uid = uuid.uuid4().hex[:8]
    ts = int(time.time() * 1000)
    note_title = title.strip() if title.strip() else cleaned.splitlines()[0][:28]

    event = {
        "type": "note",
        "id": uid,
        "title": note_title,
        "content": cleaned,
        "createdAt": ts,
    }
    atomic_write_json(os.path.join(events_dir, f"{ts}_{uid}.json"), event)

    # Also archive a local Markdown copy in ~/BgoomDrop/notes/
    safe_title = "".join(c if c.isalnum() or c in "-_ " else "_" for c in note_title).strip()[:28] or "note"
    md_path = os.path.join(notes_dir, f"{safe_title}_{uid}.md")
    with open(md_path, "w", encoding="utf-8") as f:
        f.write(f"# {note_title}\n\n{cleaned}\n")

    notify_desktop("大爆 BGOOM · 便签已发往手机", cleaned[:80])


def main() -> None:
    parser = argparse.ArgumentParser(description="BGOOM headless companion sender")
    parser.add_argument("--dir", default=os.path.expanduser("~/BgoomDrop"), help="BGOOM drop directory")
    parser.add_argument("--text", action="store_true", help="Send text from stdin or --content to phone notes")
    parser.add_argument("--title", default="", help="Optional note title")
    parser.add_argument("--content", default="", help="Optional direct text content")
    parser.add_argument("files", nargs="*", help="Files or folders to send to phone")
    args = parser.parse_args()

    if args.text:
        content = args.content if args.content else sys.stdin.read()
        queue_text(content, args.title, args.dir)
    elif args.files:
        queue_files(args.files, args.dir)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
