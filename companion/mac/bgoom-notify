#!/usr/bin/env bash
# BGOOM macOS clickable desktop notification launcher (zero idle RAM, click opens file directly)
set -euo pipefail

TITLE="${1:-大爆 BGOOM}"
BODY="${2:-收到新内容}"
FILE_PATH="${3:-}"

APP_BUNDLE="$HOME/Library/Application Support/BGOOM/BgoomNotify.app"

if [ -d "$APP_BUNDLE" ]; then
    # Use -n -g so concurrent notifications work without stealing window focus
    if [ -n "$FILE_PATH" ]; then
        open -n -g -a "$APP_BUNDLE" --args --title "$TITLE" --body "$BODY" --open "$FILE_PATH" >/dev/null 2>&1 || true
    else
        open -n -g -a "$APP_BUNDLE" --args --title "$TITLE" --body "$BODY" >/dev/null 2>&1 || true
    fi
elif command -v terminal-notifier >/dev/null 2>&1; then
    if [ -n "$FILE_PATH" ]; then
        terminal-notifier -title "$TITLE" -message "$BODY" -execute "open '$FILE_PATH'" -sound Glass >/dev/null 2>&1 || true
    else
        terminal-notifier -title "$TITLE" -message "$BODY" -sound Glass >/dev/null 2>&1 || true
    fi
else
    SAFE_T="${TITLE//\"/\'}"
    SAFE_B="${BODY//\"/\'}"
    osascript -e "display notification \"$SAFE_B\" with title \"$SAFE_T\" sound name \"Glass\"" >/dev/null 2>&1 || true
fi
